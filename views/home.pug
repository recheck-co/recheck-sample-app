extends layout

block content
  body
    .container
      h1 #{title}
      each display_error in flash ? flash.errors : []
        div(class='alert alert-danger')= display_error
      each display_info in flash ? flash.infos : []
        div(class='alert alert-info')= display_info
      h2 New Sales Rep Onboarding

      .progress_section
        span Personal Info
        | >
        span Company Info
        | >
        span.font-weight-bold Verification

      div.alert.alert-success.text-center(role="alert")
        | Recheck account connected.

      .info-group
        .label.mb-3 Recheck Verified Information
        .info-group.mx-3
          .label Legal Name
          .value=name
        .info-group.mx-3
          .label Recheck ID 
          .value ##{recheck_id}

      div.d-flex.justify-content-between.align-items-center.mt-4
        div
          form(action='/logout' method='post')
            button.btn.btn-outline-secondary.py-1.px-2(type='submit' value='Logout') Back
        div
          form(action='/reverify' method='post')
            button.btn.verify-button.py-1.px-3(type='submit') Verify Identity
